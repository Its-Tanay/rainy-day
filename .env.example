# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
# For local development with Docker: postgresql://postgres:postgres@db:5432/trip_planner
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/trip_planner
DATABASE_URL=postgresql://postgres:postgres@db:5432/trip_planner

# JWT Secret Key
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here
